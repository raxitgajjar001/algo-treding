# INDstocks API & Platform Configuration
PORT=8000
HOST=127.0.0.1
DEFAULT_MODE=PAPER  # Change to LIVE when ready for real trading

# Default Account Settings (Can also be managed directly from Web Dashboard)
INDSTOCKS_ACCOUNT_NAME=Primary INDstocks
INDSTOCKS_ACCESS_TOKEN=
INDSTOCKS_TOTAL_CAPITAL=100000
INDSTOCKS_CAPITAL_ALLOCATION_PCT=10.0
INDSTOCKS_MAX_DAILY_LOSS=2000.0

# Strategy & Risk Rules
MAX_CONCURRENT_TRADES=5
INTRADAY_TARGET_PCT=2.0
INTRADAY_STOPLOSS_PCT=1.0
SWING_TARGET_PCT=6.0
SWING_STOPLOSS_PCT=2.5
MAX_SWING_HOLDING_DAYS=7
INTRADAY_SQUAREOFF_TIME=15:15
